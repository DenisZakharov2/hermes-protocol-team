{
  "name": "hermes-protocol-team",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Validation tooling for Hermes Protocol documentation, schemas and Mermaid diagrams",
  "repository": {
    "type": "git",
    "url": "https://github.com/DenisZakharov2/hermes-protocol-team.git"
  },
  "bugs": {
    "url": "https://github.com/DenisZakharov2/hermes-protocol-team/issues"
  },
  "homepage": "https://github.com/DenisZakharov2/hermes-protocol-team#readme",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "multi-agent-system",
    "agent-orchestration",
    "fintech",
    "banking",
    "compliance",
    "json-schema",
    "mermaid",
    "documentation",
    "hermes-protocol"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "npm run validate:json && npm run validate:mermaid && npm run validate:md",
    "validate:json": "node scripts/validate-json.mjs",
    "validate:mermaid": "node scripts/check-mermaid.mjs",
    "validate:md": "markdownlint-cli2 --config .markdownlint-cli2.jsonc \"README.md\" \"docs/**/*.md\" \"skills/**/SKILL.md\" \".github/**/*.md\" \"!.github/CODE_OF_CONDUCT.md\" \"examples/README.md\" \"SECURITY.md\" \"CHANGELOG.md\"",
    "init:memory": "node scripts/init-memory.mjs",
    "sync:version": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "markdownlint-cli2": "^0.23.3"
  },
  "overrides": {
    "undici": "5.28.4",
    "string-width": "5.1.2"
  }
}

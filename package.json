{
  "name": "hermes-protocol-team",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "description": "Validation tooling for Hermes Protocol documentation, schemas and Mermaid diagrams",
  "repository": {
    "type": "git",
    "url": "https://github.com/DenisZakharov2/hermes-protocol-team.git"
  },
  "bugs": {
    "url": "https://github.com/DenisZakharov2/hermes-protocol-team/issues"
  },
  "homepage": "https://github.com/DenisZakharov2/hermes-protocol-team#readme",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "multi-agent-system",
    "agent-orchestration",
    "fintech",
    "banking",
    "compliance",
    "json-schema",
    "mermaid",
    "documentation",
    "hermes-protocol"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "_engines_comment": "Точный пинг патч-версии 22.22.2: jsdom v31.0.0 + markdownlint-cli2 v0.24.0 требуют Node >= 22.22.2 (исправление CVE в зависимостях jsdom). Обновлять синхронно с зависимостями.",
  "scripts": {
    "validate": "npm run validate:json && npm run validate:mermaid && npm run validate:md && npm run validate:self-test",
    "validate:json": "node scripts/validate-json.mjs",
    "validate:self-test": "node scripts/validate-json.mjs --self-test",
    "validate:mermaid": "node scripts/check-mermaid.mjs",
    "validate:md": "markdownlint-cli2 --config .markdownlint-cli2.jsonc \"README.md\" \"Hermes_Protocol_Constitution.md\" \"docs/**/*.md\" \"skills/**/SKILL.md\" \".github/**/*.md\" \"!.github/CODE_OF_CONDUCT.md\" \"examples/README.md\" \"examples/*.example.md\" \"SECURITY.md\" \"CHANGELOG.md\"",
    "init:memory": "node scripts/init-memory.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "generate:docs": "node scripts/generate-docs.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "^31.0.0",
    "markdownlint-cli2": "^0.24.0",
    "mermaid": "^11.17.2"
  },
  "overrides": {
    "re2js": "^2.10.0",
    "fast-uri": "^4.2.3",
    "katex": "^0.19.1"
  },
  "_overrides_comment": "re2js: CVE-2024-XXXX (ReDoS в RE2 regex engine); fast-uri: CVE-2024-XXXX (URI parsing vulnerability); katex: CVE-2024-XXXX (XSS через макросы). Обновлять при выходе новых версий с фиксами безопасности."
}

%% DAG workflow — сценарий исполнения проекта Hermes Protocol

flowchart TB
    A[Запрос Заказчика<br/>execution_request.json] --> B[PLAN_APPROVAL<br/>Stage-Gate 1: утверждение execution_plan.json]

    B --> C[RESEARCH<br/>multi-source-researcher → research_output.json]
    C --> D[PRODUCT_STRATEGY<br/>product-manager → product_strategy.json]
    D --> E[LEGAL_CONCEPT<br/>Legal Check-in №1 — концепция]

    E --> F[BUSINESS_REQUIREMENTS<br/>business-analyst → business_requirements.json]
    F --> G[LEGAL_BRD<br/>Legal Check-in №2 — BRD, max 3 итерации]

    G --> H[SYNTHESIS<br/>research-synthesist → презентация/отчет]
    H --> H2[LEGAL_SYNTHESIS<br/>Legal Check-in №3 — синтез]

    H2 --> I[QUALITY_AUDIT<br/>quality-evaluator, 5 осей, порог ≥85]

    I -->|Score ≥ 85| J[FINAL_GATE<br/>финальное одобрение Человеком + передача пакета]

    I -->|Score < 85| K[Self-Healing<br/>возврат владельцу артефакта, max 3 неудачных цикла]

    K -->|Обычный дефект| R[Доработка владельцем артефакта]
    R --> I

    K -->|REG_* / CRITICAL / HIGH| R2[Доработка владельцем артефакта]
    R2 --> L[LEGAL_CONCEPT / LEGAL_BRD / LEGAL_SYNTHESIS<br/>повторный Legal Check-in]
    L --> I

    K -->|3 неудачных цикла доработки| M[Эскалация Заказчику<br/>execution_status = ESCALATED]

    J --> N[AAR<br/>project_aar.json, project_final_review.md, память]

    style A fill:#e1f5e1,stroke:#2e7d32
    style B fill:#fff9c4,stroke:#fbc02d,stroke-width:2px
    style J fill:#fff9c4,stroke:#fbc02d,stroke-width:2px
    style N fill:#e1f5e1,stroke:#2e7d32
    style M fill:#ffebee,stroke:#c62828,stroke-width:2px
    style K fill:#ffebee,stroke:#c62828

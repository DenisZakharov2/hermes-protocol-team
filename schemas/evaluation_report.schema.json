{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:evaluation_report.schema.json",
  "title": "evaluation_report.json",
  "description": "Отчет аудита по пяти осям качества с находками и actionable_fixes.",
  "type": "object",
  "required": [
    "eval_id",
    "project_id",
    "target_worker",
    "overall_score",
    "quality_threshold",
    "passed",
    "score_breakdown",
    "critical_findings",
    "actionable_fixes"
  ],
  "properties": {
    "eval_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/EvalId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "target_worker": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TargetWorker"
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "x-i18n": {
        "title_ru": "Общий балл",
        "description_ru": "Общий балл качества (0-100)"
      }
    },
    "quality_threshold": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/QualityThreshold"
    },
    "passed": {
      "type": "boolean",
      "description": "Единственный вердикт качества. true только если overall_score >= quality_threshold и среди critical_findings нет находок уровня CRITICAL; любой CRITICAL даёт false даже при балле выше порога.",
      "x-i18n": {
        "title_ru": "Пройдено",
        "description_ru": "Флаг прохождения аудита качества"
      }
    },
    "score_breakdown": {
      "type": "object",
      "required": [
        "accuracy_and_grounding",
        "security",
        "cross_artifact_consistency",
        "structural_completeness",
        "practical_executability"
      ],
      "properties": {
        "accuracy_and_grounding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "security": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cross_artifact_consistency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "structural_completeness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "practical_executability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "x-i18n": {
        "title_ru": "Разбор по осям",
        "description_ru": "Детальные баллы по пяти осям качества"
      }
    },
    "critical_findings": {
      "type": "array",
      "description": "Только находки уровня HIGH или CRITICAL. MEDIUM/LOW-замечания переносятся в actionable_fixes.",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "field",
          "description",
          "remediation_instruction"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "HIGH",
              "CRITICAL"
            ],
            "description": "Уровень находки. CRITICAL — стоп-кран: passed обязан быть false."
          },
          "field": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "remediation_instruction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "x-i18n": {
        "title_ru": "Критические находки",
        "description_ru": "Список критических находок аудита"
      }
    },
    "actionable_fixes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-i18n": {
        "title_ru": "Действенные исправления",
        "description_ru": "Список конкретных исправлений для Self-Healing"
      }
    }
  },
  "additionalProperties": false,
  "x-i18n": {
    "title_ru": "evaluation_report.json",
    "description_ru": "Отчёт аудита по пяти осям качества с находками и actionable_fixes."
  }
}

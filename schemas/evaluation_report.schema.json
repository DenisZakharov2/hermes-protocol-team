{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "evaluation_report.json",
  "type": "object",
  "required": [
    "eval_id",
    "target_worker",
    "overall_score",
    "quality_threshold",
    "passed",
    "score_breakdown",
    "critical_findings",
    "actionable_fixes"
  ],
  "properties": {
    "eval_id": {
      "type": "string"
    },
    "target_worker": {
      "type": "string"
    },
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "quality_threshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "passed": {
      "type": "boolean"
    },
    "score_breakdown": {
      "type": "object",
      "required": [
        "accuracy_and_grounding",
        "security",
        "cross_artifact_consistency",
        "structural_completeness",
        "practical_executability"
      ],
      "properties": {
        "accuracy_and_grounding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "security": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cross_artifact_consistency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "structural_completeness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "practical_executability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "critical_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "field",
          "description",
          "remediation_instruction"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "field": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "remediation_instruction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "actionable_fixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
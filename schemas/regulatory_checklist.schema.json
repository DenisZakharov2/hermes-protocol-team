{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:regulatory_checklist.schema.json",
  "title": "regulatory_checklist.json",
  "description": "Регуляторный чек-лист требований РФ и способов проверки.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checklist_items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "applicable": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "regulation": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/RegulationRef"
          },
          "verification_method": {
            "type": "string"
          }
        },
        "required": [
          "regulation",
          "description",
          "applicable",
          "verification_method"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    }
  },
  "required": [
    "project_id",
    "checklist_items"
  ]
}

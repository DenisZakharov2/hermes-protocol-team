{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:eval_request.schema.json",
  "title": "eval_request.json",
  "description": "Запрос на аудит качества: артефакт, контекст и целевой порог.",
  "type": "object",
  "required": [
    "eval_id",
    "project_id",
    "target_worker",
    "artifact_type",
    "artifact_data",
    "context_artifacts",
    "quality_threshold"
  ],
  "properties": {
    "eval_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/EvalId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "target_worker": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TargetWorker"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "research_json",
        "brief_json",
        "brd_document",
        "product_strategy_json",
        "legal_compliance_report",
        "synthesist_output",
        "presentation",
        "executive_summary",
        "analytical_memo",
        "market_research_whitepaper"
      ]
    },
    "artifact_data": {
      "type": "object"
    },
    "context_artifacts": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
    },
    "quality_threshold": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/QualityThreshold"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:project_aar.schema.json",
  "title": "project_aar.json",
  "description": "Постпроектная рефлексия: оценка Человека, уроки и патчи скиллов.",
  "type": "object",
  "required": [
    "project_id",
    "human_rating",
    "human_feedback",
    "successful_patterns",
    "problems_found",
    "skill_patches",
    "lessons_indexed_to"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "human_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "x-i18n": {
        "title_ru": "Оценка человека",
        "description_ru": "Оценка Заказчика по итогам проекта"
      }
    },
    "human_feedback": {
      "type": "string",
      "x-i18n": {
        "title_ru": "Обратная связь человека",
        "description_ru": "Текстовая обратная связь Заказчика"
      }
    },
    "successful_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-i18n": {
        "title_ru": "Успешные паттерны",
        "description_ru": "Паттерны, проявившие себя хорошо"
      }
    },
    "problems_found": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-i18n": {
        "title_ru": "Найденные проблемы",
        "description_ru": "Проблемы, выявленные в ходе проекта"
      }
    },
    "skill_patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "section",
          "patch"
        ],
        "properties": {
          "agent_id": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/AgentId",
            "x-i18n": {
              "title_ru": "Идентификатор агента",
              "description_ru": "Системный идентификатор агента"
            }
          },
          "section": {
            "const": "Learned Guardrails",
            "description": "Единое имя раздела скилла. Агент, к которому относится патч, задаётся полем agent_id."
          },
          "patch": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "x-i18n": {
        "title_ru": "Патчи скиллов",
        "description_ru": "Предлагаемые изменения к скиллам агентов"
      }
    },
    "lessons_indexed_to": {
      "type": "string",
      "pattern": "^cases/[A-Z0-9_]+/$",
      "description": "Относительный путь к эпизодической памяти проекта: cases/{project_id}/. ProjectId — UPPER_SNAKE_CASE.",
      "x-i18n": {
        "title_ru": "Уроки индексированы в",
        "description_ru": "Путь к каталогу уроков проекта"
      }
    }
  },
  "additionalProperties": false,
  "x-i18n": {
    "title_ru": "project_aar.json",
    "description_ru": "Постпроектная рефлексия: оценка Человека, уроки и патчи скиллов."
  }
}

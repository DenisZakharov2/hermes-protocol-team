{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:project_aar.schema.json",
  "title": "project_aar.json",
  "description": "Постпроектная рефлексия: оценка Человека, уроки и патчи скиллов.",
  "type": "object",
  "required": [
    "project_id",
    "human_rating",
    "human_feedback",
    "successful_patterns",
    "problems_found",
    "skill_patches",
    "lessons_indexed_to"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "human_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "human_feedback": {
      "type": "string"
    },
    "successful_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problems_found": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skill_patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "section",
          "patch"
        ],
        "properties": {
          "agent_id": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/AgentId"
          },
          "section": {
            "type": "string"
          },
          "patch": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "lessons_indexed_to": {
      "type": "string",
      "pattern": "^/memory/cases/[^/]+/$",
      "description": "Абсолютный путь к эпизодической памяти проекта. Зафиксирован в контракте 2.2.x; переход на относительный путь — отдельный минорный релиз."
    }
  },
  "additionalProperties": false
}

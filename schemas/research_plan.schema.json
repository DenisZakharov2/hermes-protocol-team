{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:research_plan.schema.json",
  "title": "research_plan.json",
  "description": "Внутренний план исследования: подзапросы, целевые Tier и статусы.",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "created_at",
    "subqueries"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TaskId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "created_at": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TimestampISO"
    },
    "subqueries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "query",
          "target_tier",
          "status"
        ],
        "properties": {
          "query": {
            "type": "string",
            "x-i18n": {
              "title_ru": "Поисковый запрос",
              "description_ru": "Текст поискового запроса"
            }
          },
          "target_tier": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/SourceTier"
          },
          "status": {
            "type": "string",
            "enum": [
              "PLANNED",
              "IN_PROGRESS",
              "DONE",
              "BLOCKED"
            ]
          },
          "blocked_reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "x-i18n": {
        "title_ru": "Подзапросы",
        "description_ru": "Список подзапросов для исследования"
      }
    }
  },
  "additionalProperties": false,
  "x-i18n": {
    "title_ru": "research_plan.json",
    "description_ru": "Внутренний план исследования: подзапросы, целевые Tier и статусы."
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:it_landscape.schema.json",
  "title": "it_landscape.json",
  "description": "Описание IT-ландшафта и влияния продукта на системы (АБС/ДБО).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "systems": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "integration_points": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "notes": {
            "type": "string"
          },
          "system_name": {
            "type": "string"
          },
          "system_type": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/SystemType"
          },
          "impact_type": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ImpactType"
          }
        },
        "required": [
          "system_name",
          "system_type",
          "impact_type",
          "integration_points"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "systems"
  ]
}

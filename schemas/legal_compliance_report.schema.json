{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:legal_compliance_report.schema.json",
  "title": "legal_compliance_report.json",
  "description": "Юридическое заключение: статус, риски, прецеденты и меры смягчения.",
  "type": "object",
  "required": [
    "project_id",
    "legal_status",
    "overall_risk_score",
    "compliance_audit",
    "contract_disclaimers_required"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "legal_status": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/LegalStatus"
    },
    "overall_risk_score": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/RiskLevel"
    },
    "compliance_audit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "regulation",
          "article",
          "status",
          "risk_level",
          "issue",
          "required_mitigation"
        ],
        "properties": {
          "regulation": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/RegulationRef"
          },
          "article": {
            "type": "string",
            "description": "Конкретная статья/пункт нормативного акта (напр., \"ст. 5 152-ФЗ\", \"п. 2.1 Положения 821-П\")"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "WARNING",
              "FAIL"
            ],
            "description": "Результат проверки пункта аудита."
          },
          "risk_level": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/RiskLevel"
          },
          "issue": {
            "type": "string"
          },
          "judicial_precedent": {
            "anyOf": [
              {
                "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/CourtRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ссылка на опубликованный судебный акт или null, если практика не найдена. Заглушки недопустимы."
          },
          "required_mitigation": {
            "type": "string",
            "minLength": 1,
            "description": "Конкретная мера смягчения риска."
          },
          "mitigation_status": {
            "type": "string",
            "enum": [
              "OPEN",
              "DONE"
            ],
            "description": "Статус исполнения required_mitigation. При OPEN пакет не передаётся в синтез."
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "risk_level": {
                  "enum": [
                    "HIGH",
                    "CRITICAL"
                  ]
                }
              },
              "required": [
                "risk_level"
              ]
            },
            "then": {
              "required": [
                "mitigation_status"
              ]
            }
          }
        ]
      }
    },
    "contract_disclaimers_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:legal_compliance_report.schema.json",
  "title": "legal_compliance_report.json",
  "description": "Юридическое заключение: статус, риски, прецеденты и меры смягчения.",
  "type": "object",
  "required": [
    "project_id",
    "legal_status",
    "overall_risk_score",
    "compliance_audit",
    "contract_disclaimers_required"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "legal_status": {
      "type": "string",
      "enum": [
        "APPROVED",
        "APPROVED_WITH_RESERVATIONS",
        "REJECTED"
      ]
    },
    "overall_risk_score": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "compliance_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "regulation",
          "article",
          "status",
          "risk_level",
          "issue",
          "required_mitigation"
        ],
        "properties": {
          "regulation": {
            "type": "string"
          },
          "article": {
            "type": "string",
            "description": "Конкретная статья/пункт нормативного акта (напр., \"ст. 5 152-ФЗ\", \"п. 2.1 Положения 821-П\")"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "WARNING",
              "FAIL"
            ]
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "issue": {
            "type": "string"
          },
          "judicial_precedent": {
            "type": "string"
          },
          "required_mitigation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "contract_disclaimers_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

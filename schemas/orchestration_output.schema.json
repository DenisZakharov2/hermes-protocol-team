{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/DenisZakharov2/hermes-protocol-team/main/schemas/orchestration_output.schema.json",
  "title": "orchestration_output.json",
  "description": "Итоговый отчет оркестратора: Stage-Gate, пакет доставки и ссылка на AAR.",
  "type": "object",
  "required": [
    "project_id",
    "artifact_root",
    "execution_status",
    "stage_gate_history",
    "final_package"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "artifact_root": {
      "type": "string",
      "pattern": "^/memory/cases/[^/]+/artifacts/$"
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "COMPLETED_APPROVED",
        "REJECTED",
        "ESCALATED",
        "STOPPED",
        "PENDING_HUMAN"
      ]
    },
    "stage_gate_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "approved_by_human",
          "human_verdict",
          "timestamp"
        ],
        "properties": {
          "stage": {
            "type": "integer",
            "minimum": 1
          },
          "approved_by_human": {
            "type": "boolean"
          },
          "human_verdict": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED",
              "NEEDS_REWORK"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "final_package": {
      "type": "object",
      "required": [
        "product_strategy",
        "business_requirements",
        "legal_compliance_report",
        "synthesist_output",
        "quality_evaluation"
      ],
      "properties": {
        "product_strategy": {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "business_requirements": {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "legal_compliance_report": {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "quality_evaluation": {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "synthesist_output": {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "project_aar": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "COMPLETED_APPROVED"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "required": [
          "project_aar"
        ]
      }
    }
  ]
}

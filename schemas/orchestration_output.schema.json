{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:orchestration_output.schema.json",
  "title": "orchestration_output.json",
  "description": "Итоговый отчет оркестратора: Stage-Gate, пакет доставки и ссылка на AAR.",
  "type": "object",
  "required": [
    "project_id",
    "artifact_root",
    "execution_status",
    "stage_gate_history"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "artifact_root": {
      "type": "string",
      "pattern": "^cases/[A-Z0-9_]+/artifacts/$",
      "description": "Относительный путь к каталогу артефактов проекта: cases/{project_id}/artifacts/. ProjectId — UPPER_SNAKE_CASE.",
      "x-i18n": {
        "title_ru": "Корень артефактов",
        "description_ru": "Корневая директория артефактов проекта"
      }
    },
    "execution_status": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ExecutionStatus"
    },
    "stage_gate_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "stage_code",
          "approved_by_human",
          "human_verdict",
          "timestamp"
        ],
        "properties": {
          "stage": {
            "type": "integer",
            "minimum": 1,
            "description": "stage_id этапа из execution_plan, на котором проводилось утверждение."
          },
          "stage_code": {
            "$ref": "urn:hermes-protocol:schemas:execution_plan.schema.json#/definitions/StageCode",
            "description": "Стабильный код этапа (PLAN_APPROVAL, FINAL_GATE и т.д.) для инвариантной проверки.",
            "x-i18n": {
              "title_ru": "Код этапа",
              "description_ru": "Стабильный код этапа пайплайна",
              "enum_labels_ru": [
                "Утверждение плана",
                "Исследование",
                "Продуктовая стратегия",
                "Legal Check-in концепции",
                "Бизнес-требования",
                "Legal Check-in BRD",
                "Синтез",
                "Legal Check-in синтеза",
                "Аудит качества",
                "Финальный гейт",
                "AAR"
              ]
            }
          },
          "approved_by_human": {
            "type": "boolean"
          },
          "human_verdict": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/StageGateVerdict",
            "x-i18n": {
              "title_ru": "Вердикт человека",
              "description_ru": "Решение человека на Stage-Gate",
              "enum_labels_ru": [
                "Утверждено",
                "Отклонено"
              ]
            }
          },
          "timestamp": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TimestampISO"
          }
        },
        "additionalProperties": false
      },
      "x-i18n": {
        "title_ru": "История Stage-Gate",
        "description_ru": "История прохождения Stage-Gate"
      }
    },
    "final_package": {
      "type": "object",
      "required": [
        "product_strategy",
        "business_requirements",
        "legal_compliance_report",
        "synthesist_output",
        "quality_evaluation"
      ],
      "properties": {
        "product_strategy": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef",
          "x-i18n": {
            "title_ru": "Продуктовая стратегия",
            "description_ru": "Ссылка на артефакт продуктовой стратегии"
          }
        },
        "business_requirements": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef",
          "x-i18n": {
            "title_ru": "Бизнес-требования",
            "description_ru": "Ссылка на артефакт бизнес-требований"
          }
        },
        "legal_compliance_report": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef",
          "x-i18n": {
            "title_ru": "Юридическое заключение",
            "description_ru": "Ссылка на юридическое заключение"
          }
        },
        "quality_evaluation": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
        },
        "synthesist_output": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef",
          "x-i18n": {
            "title_ru": "Результат синтеза",
            "description_ru": "Ссылка на результат синтеза"
          }
        }
      },
      "additionalProperties": false
    },
    "project_aar": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "COMPLETED_APPROVED",
              "PENDING_HUMAN"
            ]
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "required": [
          "final_package"
        ],
        "properties": {
          "final_package": {
            "$ref": "#/properties/final_package"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "COMPLETED_APPROVED"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "required": [
          "project_aar"
        ],
        "properties": {
          "project_aar": {
            "$ref": "#/properties/project_aar"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "REJECTED",
              "ESCALATED",
              "STOPPED",
              "PENDING_HUMAN"
            ]
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "project_aar"
          ]
        },
        "properties": {
          "project_aar": {
            "$ref": "#/properties/project_aar"
          }
        }
      }
    }
  ],
  "x-i18n": {
    "title_ru": "orchestration_output.json",
    "description_ru": "Итоговый отчёт оркестратора: Stage-Gate, пакет доставки и ссылка на AAR."
  }
}

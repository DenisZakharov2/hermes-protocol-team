{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:orchestration_output.schema.json",
  "title": "orchestration_output.json",
  "description": "Итоговый отчет оркестратора: Stage-Gate, пакет доставки и ссылка на AAR.",
  "type": "object",
  "required": [
    "project_id",
    "artifact_root",
    "execution_status",
    "stage_gate_history"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "artifact_root": {
      "type": "string",
      "pattern": "^/memory/cases/[^/]+/artifacts/$",
      "description": "Абсолютный путь к каталогу артефактов проекта. Зафиксирован в контракте 2.2.x; переход на относительный путь — отдельный минорный релиз."
    },
    "execution_status": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ExecutionStatus"
    },
    "stage_gate_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "approved_by_human",
          "human_verdict",
          "timestamp"
        ],
        "properties": {
          "stage": {
            "type": "integer",
            "minimum": 1,
            "description": "stage_id этапа из execution_plan, на котором проводилось утверждение."
          },
          "approved_by_human": {
            "type": "boolean"
          },
          "human_verdict": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/StageGateVerdict"
          },
          "timestamp": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TimestampISO"
          }
        },
        "additionalProperties": false
      }
    },
    "final_package": {
      "type": "object",
      "required": [
        "product_strategy",
        "business_requirements",
        "legal_compliance_report",
        "synthesist_output",
        "quality_evaluation"
      ],
      "properties": {
        "product_strategy": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
        },
        "business_requirements": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
        },
        "legal_compliance_report": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
        },
        "quality_evaluation": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
        },
        "synthesist_output": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
        }
      },
      "additionalProperties": false
    },
    "project_aar": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "COMPLETED_APPROVED",
              "PENDING_HUMAN"
            ]
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "required": [
          "final_package"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "COMPLETED_APPROVED"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "required": [
          "project_aar"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "REJECTED",
              "ESCALATED",
              "STOPPED",
              "PENDING_HUMAN"
            ]
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "project_aar"
          ]
        }
      }
    }
  ]
}

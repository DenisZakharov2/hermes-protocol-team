{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:execution_request.schema.json",
  "title": "execution_request.json",
  "description": "Входной запрос Заказчика: проект, домен, требуемые артефакты и порог качества.",
  "type": "object",
  "required": [
    "project_id",
    "user_prompt",
    "domain_context",
    "output_requirements"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "user_prompt": {
      "type": "string"
    },
    "domain_context": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/DomainContext"
    },
    "output_requirements": {
      "type": "object",
      "required": [
        "target_artifacts",
        "quality_threshold"
      ],
      "properties": {
        "target_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "STRATEGY",
              "BRD",
              "PRESENTATION",
              "LEGAL_REPORT"
            ]
          }
        },
        "quality_threshold": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/QualityThreshold"
        }
      }
    }
  },
  "additionalProperties": false
}

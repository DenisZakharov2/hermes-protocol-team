{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hermes-protocol.example/schemas/execution_request.schema.json#v4.2.0",
  "title": "execution_request.json",
  "description": "Входной запрос Заказчика: проект, домен, требуемые артефакты и порог качества.",
  "type": "object",
  "required": [
    "project_id",
    "user_prompt",
    "domain_context",
    "output_requirements"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "user_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Запрос Заказчика. Макс. 5000 символов. Защита от prompt injection — схема ограничивает длину; содержание валидируется в рантайме."
    },
    "domain_context": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/DomainContext"
    },
    "output_requirements": {
      "type": "object",
      "required": [
        "target_artifacts",
        "quality_threshold"
      ],
      "properties": {
        "target_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "STRATEGY",
              "BRD",
              "PRESENTATION",
              "LEGAL_REPORT"
            ]
          }
        },
        "quality_threshold": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/QualityThreshold"
        }
      },
      "additionalProperties": false
    },
    "schema_version": {
      "$ref": "https://hermes-protocol.example/schemas/common/definitions.schema.json#/definitions/SchemaVersion"
    }
  },
  "additionalProperties": false
}
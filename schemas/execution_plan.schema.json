{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:execution_plan.schema.json",
  "title": "execution_plan.json",
  "description": "План исполнения проекта: этапы DAG, ответственные агенты и Stage-Gate.",
  "type": "object",
  "definitions": {
    "StageCode": {
      "type": "string",
      "description": "Стабильный код этапа для ссылок и возвратов Self-Healing.",
      "enum": [
        "PLAN_APPROVAL",
        "RESEARCH",
        "PRODUCT_STRATEGY",
        "LEGAL_CONCEPT",
        "BUSINESS_REQUIREMENTS",
        "LEGAL_BRD",
        "SYNTHESIS",
        "LEGAL_SYNTHESIS",
        "QUALITY_AUDIT",
        "FINAL_GATE",
        "AAR"
      ]
    }
  },
  "required": [
    "project_id",
    "plan_version",
    "created_at",
    "stages",
    "approval"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "examples": [
        "SAV_DEP_2026_01"
      ]
    },
    "plan_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "stage_code",
          "name",
          "owner_agent",
          "inputs",
          "outputs",
          "depends_on",
          "approval_required"
        ],
        "properties": {
          "stage_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Порядковый номер этапа внутри конкретного плана."
          },
          "stage_code": {
            "$ref": "#/definitions/StageCode"
          },
          "name": {
            "type": "string"
          },
          "owner_agent": {
            "type": "string",
            "enum": [
              "hermes-orchestrator",
              "multi-source-researcher",
              "product-manager",
              "business-analyst",
              "legal-compliance-counsel",
              "research-synthesist",
              "quality-evaluator"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/StageCode"
            },
            "uniqueItems": true,
            "description": "Коды этапов, которые должны завершиться до старта этого этапа."
          },
          "approval_required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "BLOCKED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "status",
        "approved_by_human"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "approved_by_human": {
          "type": "boolean"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "comments": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

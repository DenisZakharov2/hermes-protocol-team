{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:execution_plan.schema.json",
  "title": "execution_plan.json",
  "description": "План исполнения проекта: этапы DAG, ответственные агенты и Stage-Gate.",
  "type": "object",
  "definitions": {
    "StageCode": {
      "type": "string",
      "description": "Стабильный код этапа для ссылок и возвратов Self-Healing.",
      "enum": [
        "PLAN_APPROVAL",
        "RESEARCH",
        "PRODUCT_STRATEGY",
        "LEGAL_CONCEPT",
        "BUSINESS_REQUIREMENTS",
        "LEGAL_BRD",
        "SYNTHESIS",
        "LEGAL_SYNTHESIS",
        "QUALITY_AUDIT",
        "FINAL_GATE",
        "AAR"
      ]
    },
    "MandatoryPipeline": {
      "type": "array",
      "description": "Нормативный упорядоченный список всех 11 обязательных этапов пайплайна. Порядок фиксирован и не может быть изменен.",
      "items": {
        "type": "object",
        "required": [
          "stage_code",
          "approval_required",
          "minimal_depends_on"
        ],
        "properties": {
          "stage_code": { "$ref": "#/definitions/StageCode" },
          "approval_required": { "type": "boolean" },
          "minimal_depends_on": {
            "type": "array",
            "items": { "$ref": "#/definitions/StageCode" },
            "uniqueItems": true
          }
        }
      },
      "const": [
        { "stage_code": "PLAN_APPROVAL", "approval_required": true, "minimal_depends_on": [] },
        { "stage_code": "RESEARCH", "approval_required": false, "minimal_depends_on": ["PLAN_APPROVAL"] },
        { "stage_code": "PRODUCT_STRATEGY", "approval_required": false, "minimal_depends_on": ["RESEARCH"] },
        { "stage_code": "LEGAL_CONCEPT", "approval_required": false, "minimal_depends_on": ["PRODUCT_STRATEGY"] },
        { "stage_code": "BUSINESS_REQUIREMENTS", "approval_required": false, "minimal_depends_on": ["LEGAL_CONCEPT"] },
        { "stage_code": "LEGAL_BRD", "approval_required": false, "minimal_depends_on": ["BUSINESS_REQUIREMENTS"] },
        { "stage_code": "SYNTHESIS", "approval_required": false, "minimal_depends_on": ["LEGAL_BRD"] },
        { "stage_code": "LEGAL_SYNTHESIS", "approval_required": false, "minimal_depends_on": ["SYNTHESIS"] },
        { "stage_code": "QUALITY_AUDIT", "approval_required": false, "minimal_depends_on": ["LEGAL_SYNTHESIS"] },
        { "stage_code": "FINAL_GATE", "approval_required": true, "minimal_depends_on": ["QUALITY_AUDIT"] },
        { "stage_code": "AAR", "approval_required": false, "minimal_depends_on": ["FINAL_GATE"] }
      ]
    }
  },
  "required": [
    "project_id",
    "plan_version",
    "created_at",
    "stages",
    "approval"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "plan_version": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/VersionString"
    },
    "created_at": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TimestampISO"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "stage_code",
          "name",
          "owner_agent",
          "inputs",
          "outputs",
          "depends_on",
          "approval_required",
          "status"
        ],
        "properties": {
          "stage_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Порядковый номер этапа внутри конкретного плана. Должен начинаться с 1 и идти последовательно без пропусков (stage_id === index + 1)."
          },
          "stage_code": {
            "$ref": "#/definitions/StageCode"
          },
          "name": {
            "type": "string"
          },
          "owner_agent": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/AgentId"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/StageCode"
            },
            "uniqueItems": true,
            "description": "Коды этапов, которые должны завершиться до старта этого этапа."
          },
          "approval_required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "BLOCKED"
            ],
            "description": "Текущий статус этапа в жизненном цикле проекта."
          }
        },
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "status",
        "approved_by_human"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "approved_by_human": {
          "type": "boolean"
        },
        "approved_at": {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TimestampISO"
        },
        "comments": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:ba_input_contract.schema.json",
  "title": "ba_input_contract.json",
  "description": "Входной контракт бизнес-аналитика: стратегия, чек-лист, IT-ландшафт и формат вывода.",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "product_strategy",
    "regulatory_checklist",
    "it_landscape",
    "output_format"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TaskId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "product_strategy": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
    },
    "regulatory_checklist": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
    },
    "it_landscape": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
    },
    "output_format": {
      "type": "string",
      "enum": [
        "CLASSIC_BRD",
        "AGILE_USER_STORIES",
        "HYBRID"
      ]
    }
  },
  "additionalProperties": false
}

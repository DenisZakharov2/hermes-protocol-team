{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/DenisZakharov2/hermes-protocol-team/main/schemas/ba_input_contract.schema.json",
  "title": "ba_input_contract.json",
  "description": "Входной контракт бизнес-аналитика: стратегия, чек-лист, IT-ландшафт и формат вывода.",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "product_strategy",
    "regulatory_checklist",
    "it_landscape",
    "output_format"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "product_strategy": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "regulatory_checklist": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "it_landscape": {
      "type": "object",
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output_format": {
      "type": "string",
      "enum": [
        "CLASSIC_BRD",
        "AGILE_USER_STORIES",
        "HYBRID"
      ]
    }
  },
  "additionalProperties": false
}

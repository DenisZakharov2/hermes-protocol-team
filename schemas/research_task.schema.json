{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:research_task.schema.json",
  "title": "research_task.json",
  "description": "Задание исследователю: поисковый запрос, цель, глубина и требуемые сущности.",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "query",
    "research_objective",
    "target_audience",
    "depth_level",
    "required_entities",
    "out_of_scope"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TaskId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "query": {
      "type": "string",
      "x-i18n": {
        "title_ru": "Поисковый запрос",
        "description_ru": "Текст поискового запроса"
      }
    },
    "research_objective": {
      "type": "string",
      "x-i18n": {
        "title_ru": "Цель исследования",
        "description_ru": "Цель и ожидаемый результат исследования"
      }
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "executive",
        "technical",
        "general"
      ],
      "x-i18n": {
        "title_ru": "Целевая аудитория",
        "description_ru": "Целевая аудитория исследования",
        "enum_labels_ru": [
          "Руководство",
          "Технические специалисты",
          "Общая"
        ]
      }
    },
    "depth_level": {
      "type": "string",
      "enum": [
        "fast_scan",
        "standard_deep",
        "exhaustive"
      ],
      "x-i18n": {
        "title_ru": "Уровень глубины",
        "description_ru": "Глубина исследования",
        "enum_labels_ru": [
          "Быстрый скан",
          "Стандартная глубина",
          "Исчерпывающее"
        ]
      }
    },
    "required_entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-i18n": {
        "title_ru": "Требуемые сущности",
        "description_ru": "Список сущностей, которые должны быть найдены"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-i18n": {
        "title_ru": "Вне области",
        "description_ru": "Темы, исключённые из исследования"
      }
    }
  },
  "additionalProperties": false,
  "x-i18n": {
    "title_ru": "research_task.json",
    "description_ru": "Задание исследователю: поисковый запрос, цель, глубина и требуемые сущности."
  }
}

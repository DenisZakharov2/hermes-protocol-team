{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:agent_tuning_log.schema.json",
  "title": "agent_tuning_log.json",
  "description": "Журнал оперативных корректировок агентов и предложенных патчей скиллов.",
  "type": "object",
  "required": [
    "project_id",
    "entries"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "agent_id",
          "source",
          "observation",
          "proposed_patch"
        ],
        "properties": {
          "timestamp": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TimestampISO"
          },
          "agent_id": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/AgentId"
          },
          "source": {
            "type": "string",
            "enum": [
              "HUMAN",
              "QUALITY_EVALUATOR",
              "LEGAL_COUNSEL"
            ]
          },
          "observation": {
            "type": "string"
          },
          "proposed_patch": {
            "type": "string"
          },
          "applied": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:research_output.schema.json",
  "title": "research_output.json",
  "description": "Результат исследования: тезисы, метрики с source_id, конфликты и каталог источников.",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "key_takeaways",
    "quantifiable_metrics",
    "conflicts_and_limitations",
    "sources"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TaskId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "key_takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quantifiable_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric_name",
          "value",
          "unit",
          "source_id"
        ],
        "properties": {
          "metric_name": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "description": "Единица измерения. Для ставок используйте «% годовых», для денежных сумм — «руб.»"
          },
          "source_id": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/SourceId"
          }
        },
        "additionalProperties": false
      }
    },
    "conflicts_and_limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "source_a_claim",
          "source_b_claim"
        ],
        "properties": {
          "issue": {
            "type": "string"
          },
          "source_a_claim": {
            "type": "string"
          },
          "source_b_claim": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "url",
          "tier_level",
          "reliability_score",
          "illustrative"
        ],
        "properties": {
          "source_id": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/SourceId"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Конкретная страница источника. Корневой URL допустим только при illustrative: true."
          },
          "tier_level": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/SourceTier"
          },
          "reliability_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "illustrative": {
            "type": "boolean",
            "description": "true — источник используется как учебная иллюстрация, цифры не считаются подтверждёнными этим URL."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

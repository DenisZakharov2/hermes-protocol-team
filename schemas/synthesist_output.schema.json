{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:synthesist_output.schema.json",
  "title": "synthesist_output.json",
  "description": "Выходной контракт синтеза: разметка или код документа, диаграммы и сноски.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "citations_index": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "deliverable_content": {
      "type": "string"
    },
    "generated_diagrams": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "output_format": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/OutputFormat"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "task_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TaskId"
    },
    "visualization_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "title",
          "source"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Тип визуализации (bar, line, table и т. п.)"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Ссылка на артефакт-источник данных"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "task_id",
    "project_id",
    "output_format",
    "deliverable_content"
  ]
}

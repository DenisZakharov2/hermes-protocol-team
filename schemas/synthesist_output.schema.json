{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/DenisZakharov2/hermes-protocol-team/main/schemas/synthesist_output.schema.json",
  "title": "synthesist_output.json",
  "description": "Выходной контракт синтеза: разметка или код документа, диаграммы и сноски.",
  "additionalProperties": false,
  "properties": {
    "citations_index": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "deliverable_content": {
      "type": "string"
    },
    "generated_diagrams": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "output_format": {
      "enum": [
        "markdown_marp",
        "python_pptx_script",
        "html_tailwind_deck",
        "structured_slides_json",
        "markdown_report",
        "python_docx_script",
        "typst_pdf_markup"
      ],
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "visualization_specs": {
      "items": {
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "project_id",
    "output_format",
    "deliverable_content"
  ],
  "type": "object"
}

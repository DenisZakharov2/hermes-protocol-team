{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:flight_log.schema.json",
  "title": "flight_log.json",
  "description": "Универсальный бортовой журнал агента: фазы, передачи, Stage-Gate и ошибки.",
  "type": "object",
  "required": [
    "project_id",
    "agent_id",
    "entries"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "agent_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/AgentId"
    },
    "sanitized_user_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Очищенный от потенциальных инъекций запрос Заказчика. Макс. 5000 символов. Заполняется оркестратором перед стартом."
    },
    "sanitization_applied": {
      "type": "boolean",
      "description": "Был ли применен санитайзер к user_prompt (true если были изменения)."
    },
    "original_prompt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$",
      "description": "SHA256 хеш оригинального user_prompt (первые 16 символов) для аудита в flight_log."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "phase",
          "event_type",
          "status",
          "details"
        ],
        "properties": {
          "timestamp": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TimestampISO"
          },
          "phase": {
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "PHASE_START",
              "PHASE_END",
              "HANDOFF",
              "STAGE_GATE",
              "SELF_HEALING",
              "ERROR",
              "LEGAL_CHECKIN",
              "QUALITY_AUDIT",
              "AAR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "WARNING",
              "ERROR",
              "BLOCKED"
            ]
          },
          "details": {
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "self_healing_attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Номер попытки Self-Healing (0–3 в схеме). Для SELF_HEALING обязателен; инвариант требует монотонную последовательность 1→2→3 внутри phase."
          },
          "legal_iteration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Номер итерации Legal Check-in (0–3 в схеме). Для LEGAL_CHECKIN обязателен; инвариант требует монотонную последовательность 1→2→3 внутри phase."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "SELF_HEALING"
                }
              },
              "required": ["event_type"]
            },
            "then": {
              "required": ["self_healing_attempt"],
              "properties": {
                "self_healing_attempt": {
                  "$ref": "#/properties/entries/items/properties/self_healing_attempt"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "LEGAL_CHECKIN"
                }
              },
              "required": ["event_type"]
            },
            "then": {
              "required": ["legal_iteration"],
              "properties": {
                "legal_iteration": {
                  "$ref": "#/properties/entries/items/properties/legal_iteration"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

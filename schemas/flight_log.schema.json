{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:flight_log.schema.json",
  "title": "flight_log.json",
  "description": "Универсальный бортовой журнал агента: фазы, передачи, Stage-Gate и ошибки.",
  "type": "object",
  "required": [
    "project_id",
    "agent_id",
    "entries"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "agent_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/AgentId"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "phase",
          "event_type",
          "status",
          "details"
        ],
        "properties": {
          "timestamp": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TimestampISO"
          },
          "phase": {
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "PHASE_START",
              "PHASE_END",
              "HANDOFF",
              "STAGE_GATE",
              "SELF_HEALING",
              "ERROR",
              "LEGAL_CHECKIN",
              "QUALITY_AUDIT",
              "AAR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "WARNING",
              "ERROR",
              "BLOCKED"
            ]
          },
          "details": {
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "self_healing_attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Номер попытки Self-Healing (0–3); 3 — лимит до эскалации"
          },
          "legal_iteration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Номер итерации Legal Check-in (0–3)"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

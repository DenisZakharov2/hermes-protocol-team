{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hermes-protocol.example/schemas/flight_log.schema.json#v4.2.0",
  "title": "flight_log.json",
  "description": "Универсальный бортовой журнал агента: фазы, передачи, Stage-Gate и ошибки.",
  "type": "object",
  "required": [
    "project_id",
    "agent_id",
    "entries"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "agent_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/AgentId"
    },
    "sanitized_user_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Очищенный от потенциальных инъекций запрос Заказчика. Макс. 5000 символов. Заполняется оркестратором перед стартом."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "phase",
          "event_type",
          "status",
          "details",
          "duration_ms",
          "tokens_used",
          "model"
        ],
        "properties": {
          "timestamp": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TimestampISO"
          },
          "phase": {
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "PHASE_START",
              "PHASE_END",
              "HANDOFF",
              "STAGE_GATE",
              "SELF_HEALING",
              "ERROR",
              "LEGAL_CHECKIN",
              "QUALITY_AUDIT",
              "AAR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "WARNING",
              "ERROR",
              "BLOCKED"
            ]
          },
          "details": {
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "Длительность операции в миллисекундах."
          },
          "tokens_used": {
            "type": "object",
            "required": ["input", "output", "total"],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "integer",
                "minimum": 0,
                "description": "Количество входных токенов."
              },
              "output": {
                "type": "integer",
                "minimum": 0,
                "description": "Количество выходных токенов."
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "description": "Общее количество токенов (input + output)."
              }
            },
            "description": "Токены, использованные при вызове LLM."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Идентификатор модели (например, gpt-4o, claude-3.5-sonnet)."
          },
          "retry_reason": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "INVARIANT_ERROR",
              "TIMEOUT",
              "RATE_LIMIT",
              "OTHER"
            ],
            "description": "Причина ретрая, если операция была повторена."
          },
          "sanitization_applied": {
            "type": "boolean",
            "description": "Был ли применен санитайзер к user_prompt (true если были изменения)."
          },
          "original_prompt_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$",
            "description": "SHA256 хеш оригинального user_prompt (первые 16 символов) для аудита в flight_log."
          },
          "self_healing_attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Номер попытки Self-Healing (0–3 в схеме). Для SELF_HEALING обязателен; инвариант требует монотонную последовательность 1→2→3 внутри phase."
          },
          "legal_iteration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Номер итерации Legal Check-in (0–3 в схеме). Для LEGAL_CHECKIN обязателен; инвариант требует монотонную последовательность 1→2→3 внутри phase."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "SELF_HEALING"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "then": {
              "required": [
                "self_healing_attempt"
              ],
              "properties": {
                "self_healing_attempt": {
                  "$ref": "#/properties/entries/items/properties/self_healing_attempt"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "LEGAL_CHECKIN"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "then": {
              "required": [
                "legal_iteration"
              ],
              "properties": {
                "legal_iteration": {
                  "$ref": "#/properties/entries/items/properties/legal_iteration"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "schema_version": {
      "$ref": "https://hermes-protocol.example/schemas/common/definitions.schema.json#/definitions/SchemaVersion"
    }
  },
  "additionalProperties": false
}
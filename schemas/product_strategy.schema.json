{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:product_strategy.schema.json",
  "title": "product_strategy.json",
  "description": "Продуктовая концепция, тарифы, финансовая модель и регуляторные ограничения.",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "product_concept",
    "financial_model",
    "regulatory_guardrails",
    "prioritization_rice"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TaskId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "product_concept": {
      "type": "object",
      "required": [
        "value_proposition",
        "target_segments",
        "tariff_structure"
      ],
      "properties": {
        "value_proposition": {
          "type": "string"
        },
        "target_segments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tariff_structure": {
          "type": "object",
          "required": [
            "base_rate_percent",
            "welcome_rate_percent",
            "mgs_percent"
          ],
          "properties": {
            "base_rate_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Базовая ставка, % годовых."
            },
            "welcome_rate_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Приветственная ставка, % годовых."
            },
            "mgs_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Минимальная гарантированная ставка (МГС), % годовых."
            }
          },
          "additionalProperties": false,
          "description": "Тарифные ставки в процентных пунктах годовых (не в долях)."
        }
      },
      "additionalProperties": false,
      "description": "Продуктовая концепция и тарифная структура. Ставки задаются в процентных пунктах."
    },
    "financial_model": {
      "type": "object",
      "required": [
        "projected_nii",
        "projected_nim_percent",
        "cof_cost_of_funds_percent",
        "ltv_cac_ratio"
      ],
      "properties": {
        "projected_nii": {
          "type": "number",
          "description": "Прогнозный чистый процентный доход, руб."
        },
        "projected_nim_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Прогнозная чистая процентная маржа, % годовых."
        },
        "cof_cost_of_funds_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Стоимость фондирования (CoF), % годовых."
        },
        "ltv_cac_ratio": {
          "type": "number",
          "minimum": 0,
          "description": "Отношение LTV к CAC (безразмерное)."
        }
      },
      "additionalProperties": false,
      "description": "Финансовая модель. Ставки и NIM задаются в процентных пунктах, денежные суммы — в рублях."
    },
    "regulatory_guardrails": {
      "type": "object",
      "required": [
        "psk_limit_check",
        "mpl_limit_check",
        "cbr_mgs_compliance"
      ],
      "properties": {
        "psk_limit_check": {
          "type": "string",
          "enum": [
            "PASSED",
            "FAILED",
            "WARNING",
            "NOT_APPLICABLE"
          ],
          "description": "Проверка ПСК; для вкладов и иных некредитных продуктов — NOT_APPLICABLE."
        },
        "mpl_limit_check": {
          "type": "string",
          "enum": [
            "PASSED",
            "FAILED",
            "WARNING",
            "NOT_APPLICABLE"
          ],
          "description": "Проверка макропруденциального лимита; для некредитных продуктов — NOT_APPLICABLE."
        },
        "cbr_mgs_compliance": {
          "type": "string",
          "enum": [
            "PASSED",
            "FAILED",
            "WARNING",
            "NOT_APPLICABLE"
          ],
          "description": "Соблюдение правил раскрытия МГС."
        },
        "not_applicable_reason": {
          "type": "string",
          "description": "Причина, по которой проверки ПСК/МПЛ не применяются к продукту."
        }
      },
      "additionalProperties": false,
      "description": "Регуляторные проверки. Для неприменимой проверки используйте NOT_APPLICABLE и поясните причину."
    },
    "prioritization_rice": {
      "type": "object",
      "required": [
        "score"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

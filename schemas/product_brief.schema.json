{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:product_brief.schema.json",
  "title": "product_brief.json",
  "description": "Бриф для продуктового стратега: тип продукта, контекст банка и ссылка на исследование.",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "product_type",
    "bank_context",
    "market_data"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TaskId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "DEPOSIT",
        "SAVINGS_ACC",
        "CONSUMER_LOAN",
        "CREDIT_CARD",
        "MORTGAGE"
      ]
    },
    "bank_context": {
      "type": "object",
      "required": [
        "license_type",
        "business_model",
        "liquidity_position"
      ],
      "properties": {
        "license_type": {
          "type": "string"
        },
        "business_model": {
          "type": "string",
          "enum": [
            "AGGRESSIVE_GROWTH",
            "NIM_MAXIMIZATION"
          ]
        },
        "liquidity_position": {
          "type": "string",
          "enum": [
            "SURPLUS",
            "DEFICIT"
          ]
        }
      },
      "additionalProperties": false
    },
    "market_data": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
    }
  },
  "additionalProperties": false
}

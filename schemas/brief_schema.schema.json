{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:brief_schema.schema.json",
  "title": "brief_schema.json",
  "description": "Бриф на синтез и верстку: тип документа, формат, аудитория и брендинг.",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "document_type",
    "output_format",
    "target_audience",
    "custom_branding",
    "research_data"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TaskId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "pitch_deck",
        "executive_summary",
        "analytical_memo",
        "market_research_whitepaper"
      ]
    },
    "output_format": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/OutputFormat"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "executive",
        "investor",
        "technical",
        "general_business"
      ]
    },
    "custom_branding": {
      "type": "object",
      "required": [
        "primary_color",
        "accent_color",
        "font_family"
      ],
      "properties": {
        "primary_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "font_family": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "research_data": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
    }
  },
  "additionalProperties": false
}

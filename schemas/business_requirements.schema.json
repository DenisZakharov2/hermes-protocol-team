{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hermes-protocol.example/schemas/business_requirements.schema.json#v4.2.0",
  "title": "business_requirements.json",
  "description": "BRD, Gherkin-истории, NFR и матрица влияния на IT-ландшафт.",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "system_impact_matrix",
    "classic_brd",
    "agile_backlog",
    "regulatory_nfr"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/TaskId"
    },
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "system_impact_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "system_name",
          "impact_type",
          "description"
        ],
        "properties": {
          "system_name": {
            "type": "string"
          },
          "impact_type": {
            "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ImpactType"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "classic_brd": {
      "type": "object",
      "required": [
        "business_process_tobe",
        "functional_requirements"
      ],
      "properties": {
        "business_process_tobe": {
          "type": "string"
        },
        "functional_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "agile_backlog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "user_story",
          "acceptance_criteria_gherkin"
        ],
        "properties": {
          "user_story": {
            "type": "string"
          },
          "acceptance_criteria_gherkin": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "regulatory_nfr": {
      "type": "object",
      "required": [
        "data_masking_152_fz",
        "correlation_id_logging",
        "sla_availability",
        "rpo_minutes",
        "rto_minutes"
      ],
      "properties": {
        "data_masking_152_fz": {
          "type": "boolean",
          "description": "Маскирование ПДн по 152-ФЗ. Значение false допустимо только при наличии непустого masking_exception с описанием исключения и компенсирующих мер."
        },
        "masking_exception": {
          "type": "string",
          "minLength": 1,
          "description": "Описание исключения из маскирования ПДн и компенсирующих мер. Обязательно при data_masking_152_fz: false; передаётся в Legal Check-in и отражается в юридическом заключении."
        },
        "correlation_id_logging": {
          "type": "boolean"
        },
        "sla_availability": {
          "type": "string",
          "pattern": "^99\\.9\\d*%$",
          "description": "Доступность 99.9–99.99… % включительно: принимаются 99.9%, 99.90%, 99.95%, 99.99%."
        },
        "rpo_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "rto_minutes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "data_masking_152_fz": {
                "const": false
              }
            },
            "required": [
              "data_masking_152_fz"
            ]
          },
          "then": {
            "required": [
              "masking_exception"
            ],
            "properties": {
              "masking_exception": {
                "$ref": "#/properties/regulatory_nfr/properties/masking_exception"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "schema_version": {
      "$ref": "https://hermes-protocol.example/schemas/common/definitions.schema.json#/definitions/SchemaVersion"
    }
  },
  "additionalProperties": false
}
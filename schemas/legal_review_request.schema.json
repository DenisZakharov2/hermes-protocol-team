{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-protocol:schemas:legal_review_request.schema.json",
  "title": "legal_review_request.json",
  "description": "Запрос на правовую проверку концепции или BRD.",
  "type": "object",
  "required": [
    "project_id",
    "product_concept",
    "target_audience",
    "jurisdiction"
  ],
  "properties": {
    "project_id": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ProjectId"
    },
    "product_concept": {
      "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
    },
    "business_requirements": {
      "anyOf": [
        {
          "$ref": "urn:hermes-protocol:schemas:common:definitions.schema.json#/definitions/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "x-i18n": {
        "title_ru": "Бизнес-требования",
        "description_ru": "Ссылка на артефакт бизнес-требований"
      }
    },
    "target_audience": {
      "type": "string",
      "x-i18n": {
        "title_ru": "Целевая аудитория",
        "description_ru": "Целевая аудитория (executive, technical, general)",
        "enum_labels_ru": [
          "Руководство",
          "Технические специалисты",
          "Общая"
        ]
      }
    },
    "jurisdiction": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "x-i18n": {
    "title_ru": "legal_review_request.json",
    "description_ru": "Запрос на правовую проверку концепции или BRD."
  }
}
